<%- include('./base/header.ejs') %>

<style>
    .settings-content {
        margin-left: 250px;
        padding: 80px 40px 40px 40px;
        background-color: #f8f9fa;
        min-height: 100vh;
        width: calc(100% - 250px);
    }

    .settings-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }

    .settings-header {
        border-bottom: 2px solid #f1f3f5;
        margin-bottom: 25px;
        padding-bottom: 10px;
        color: #2c3e50;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .btn-save {
        background-color: #4e73df;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: bold;
        border: none;
        transition: background-color 0.3s ease;
    }

    .btn-save:hover {
        background-color: #2e59d9;
    }

    .settings-section-title {
        font-size: 1.2rem;
        font-weight: bold;
        color: #5a5c69;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }

    .settings-section-title i {
        margin-right: 10px;
        color: #4e73df;
    }
</style>

<div class="main-container">
    <%- include('./base/sideBar.ejs') %>
    
    <div class="settings-content">
        <div class="settings-header">
            <h2><i class="fas fa-cog"></i> Settings</h2>
            <p class="text-muted">Manage your profile and system preferences.</p>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Profile Information -->
                <div class="settings-card">
                    <div class="settings-section-title">
                        <i class="fas fa-user-circle"></i> Profile Information
                    </div>
                    <form action="/update/user/<%= user._id %>" method="POST">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">First Name</label>
                                <input type="text" name="FirstName" class="form-control" value="<%= user.FirstName %>" required>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Last Name</label>
                                <input type="text" name="LastName" class="form-control" value="<%= user.LastName %>" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="email" class="form-control" value="<%= user.email %>" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Mobile Number</label>
                            <input type="text" name="MobileNo" class="form-control" value="<%= user.MobileNo %>">
                        </div>
                        <button type="submit" class="btn btn-save">Update Profile</button>
                    </form>
                </div>

                <!-- Security -->
                <div class="settings-card">
                    <div class="settings-section-title">
                        <i class="fas fa-shield-alt"></i> Security
                    </div>
                    <form action="/update/user/<%= user._id %>" method="POST">
                        <div class="form-group">
                            <label class="form-label">New Password</label>
                            <input type="password" name="PassWord" class="form-control" placeholder="Leave blank to keep current password">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPass" class="form-control" placeholder="Confirm new password">
                        </div>
                        <button type="submit" class="btn btn-save" style="background-color: #f6c23e; color: #333;">Change Password</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- System Info -->
                <div class="settings-card">
                    <div class="settings-section-title">
                        <i class="fas fa-info-circle"></i> System Information
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Version
                            <span class="badge bg-primary rounded-pill">1.0.0</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Environment
                            <span class="badge bg-success rounded-pill">Production</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Database
                            <span class="badge bg-info rounded-pill">MongoDB</span>
                        </li>
                    </ul>
                </div>

                <!-- Appearance Placeholder -->
                <div class="settings-card">
                    <div class="settings-section-title">
                        <i class="fas fa-paint-brush"></i> Appearance
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                        <label class="form-check-label" for="darkModeSwitch">Dark Mode (Coming Soon)</label>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Primary Color</label>
                        <select class="form-control">
                            <option>Classic Blue</option>
                            <option>Emerald Green</option>
                            <option>Sunset Orange</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./base/footer.ejs') %>
