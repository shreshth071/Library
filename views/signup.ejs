<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Library Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Nunito', sans-serif;
        }

        body, html {
            height: 100%;
            width: 100%;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Robot Background */
        .robot-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .robot-background iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Glassmorphism Signup Card */
        .signup-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 550px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 30px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            text-align: center;
            color: #fff;
            max-height: 90vh;
            overflow-y: auto;
        }

        /* Custom scrollbar for the card */
        .signup-card::-webkit-scrollbar {
            width: 6px;
        }
        .signup-card::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

        .signup-header i {
            font-size: 3rem;
            color: #fff;
            margin-bottom: 15px;
        }

        .signup-header h1 {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 5px;
            color: #fff;
        }

        .signup-header p {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 15px;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 5px;
            font-weight: 700;
            color: #fff;
            font-size: 0.85rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.2);
            border-color: #fff;
            outline: none;
        }

        .row {
            display: flex;
            gap: 15px;
        }

        .signup-btn {
            width: 100%;
            padding: 14px;
            background: #fff;
            color: #2c3e50;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
        }

        .signup-btn:hover {
            transform: translateY(-2px);
            background: #f8f9fa;
        }

        .footer-links {
            margin-top: 20px;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .footer-links a {
            color: #fff;
            text-decoration: underline;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <!-- Robot Integrated Background -->
    <div class="robot-background">
        <iframe src='https://my.spline.design/robotinteractiveevents-5864473e1a2171a0a5458b8bd11d54bf/' frameborder='0'></iframe>
    </div>

    <!-- Integrated Signup Form -->
    <div class="signup-card">
        <div class="signup-header">
            <i class="fas fa-user-plus"></i>
            <h1>Create Account</h1>
            <p>Join our community today</p>
        </div>

        <form action="/add/user" method="post">
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="john@example.com" required>
            </div>

            <div class="row">
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">First Name</label>
                    <input type="text" name="FirstName" class="form-control" placeholder="John" required>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Last Name</label>
                    <input type="text" name="LastName" class="form-control" placeholder="Doe" required>
                </div>
            </div>

            <div class="row">
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Mobile Number</label>
                    <input type="text" name="mobile" class="form-control" placeholder="1234567890" required>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Country</label>
                    <input type="text" name="country" class="form-control" placeholder="USA" required>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input type="password" name="PassWord" class="form-control" placeholder="••••••••" required>
            </div>

            <div class="form-group">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="ConfirmPass" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" class="signup-btn">Sign Up Now</button>
        </form>

        <div class="footer-links">
            <p>Already have an account? <a href="/login">Log in here</a></p>
        </div>
    </div>
</body>
</html>
