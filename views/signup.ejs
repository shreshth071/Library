<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Library Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Nunito', sans-serif;
        }

        body {
            height: 100vh;
            display: flex;
            background: #f4f7f6;
            overflow: hidden;
        }

        .signup-wrapper {
            display: flex;
            width: 100%;
            height: 100%;
        }

        /* Left Side: Form */
        .form-side {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            background: white;
            z-index: 10;
            box-shadow: 10px 0 30px rgba(0,0,0,0.05);
            overflow-y: auto;
        }

        .signup-card {
            width: 100%;
            max-width: 500px;
            padding: 20px 0;
        }

        .signup-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .signup-header i {
            font-size: 3rem;
            color: #1cc88a;
            margin-bottom: 10px;
        }

        .signup-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            display: block;
            margin-bottom: 5px;
            font-weight: 700;
            color: #495057;
            font-size: 0.85rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border-radius: 10px;
            border: 2px solid #f1f3f5;
            background: #f8f9fa;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .form-control:focus {
            border-color: #1cc88a;
            background: white;
            box-shadow: 0 0 0 4px rgba(28, 200, 138, 0.1);
            outline: none;
        }

        .row {
            display: flex;
            gap: 15px;
        }

        .signup-btn {
            width: 100%;
            padding: 14px;
            background: #1cc88a;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
        }

        .signup-btn:hover {
            background: #17a673;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(28, 200, 138, 0.3);
        }

        .footer-links {
            text-align: center;
            margin-top: 25px;
            font-size: 0.95rem;
            color: #6c757d;
        }

        .footer-links a {
            color: #1cc88a;
            text-decoration: none;
            font-weight: 700;
        }

        /* Right Side: Robot Animation */
        .robot-side {
            flex: 1.2;
            background: #f4f7f6;
            position: relative;
            overflow: hidden;
        }

        .robot-side iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        @media (max-width: 992px) {
            .robot-side {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="signup-wrapper">
        <div class="form-side">
            <div class="signup-card">
                <div class="signup-header">
                    <i class="fas fa-user-plus"></i>
                    <h1>Create Account</h1>
                    <p class="text-muted">Join our library management system today</p>
                </div>

                <form action="/add/user" method="post">
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="john@example.com" required>
                    </div>

                    <div class="row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" class="form-control" placeholder="John" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" class="form-control" placeholder="Doe" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Mobile Number</label>
                            <input type="text" name="mobile" class="form-control" placeholder="1234567890" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Country</label>
                            <input type="text" name="country" class="form-control" placeholder="USA" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <input type="password" name="PassWord" class="form-control" placeholder="••••••••" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="ConfirmPass" class="form-control" placeholder="••••••••" required>
                    </div>

                    <button type="submit" class="signup-btn">Sign Up Now</button>
                </form>

                <div class="footer-links">
                    <p>Already have an account? <a href="/login">Sign in here</a></p>
                </div>
            </div>
        </div>

        <div class="robot-side">
            <iframe src='https://my.spline.design/robotinteractiveevents-5864473e1a2171a0a5458b8bd11d54bf/' frameborder='0'></iframe>
        </div>
    </div>
</body>
</html>
