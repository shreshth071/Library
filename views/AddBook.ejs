<%- include('./base/header.ejs') %>

<style>
    .main-content {
        margin-left: 250px;
        padding: 80px 40px 40px 40px;
        background-color: #f8f9fa;
        min-height: 100vh;
        width: calc(100% - 250px);
    }

    .form-card {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        max-width: 900px;
        margin: 0 auto;
    }

    .form-section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 25px;
        border-bottom: 2px solid #f1f3f5;
        padding-bottom: 10px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #ced4da;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .submit-btn {
        background-color: #4e73df;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: bold;
        border: none;
        transition: all 0.3s ease;
    }

    .submit-btn:hover {
        background-color: #2e59d9;
        transform: translateY(-2px);
    }
</style>

<div class="main-container d-flex">
    <%- include('./base/sideBar.ejs') %>
    
    <div class="main-content flex-grow-1">
        <div class="form-card">
            <h1 class="h3 mb-4 text-gray-800">Add New Book to Inventory</h1>
            
            <form action="/book/add" method="POST" enctype="multipart/form-data">
                <div class="form-section-title">
                    <i class="fas fa-info-circle mr-2 text-primary"></i> Basic Information
                </div>
                
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Book Title</label>
                        <input type="text" name="bookTitle" class="form-control" placeholder="Enter book title" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Publisher</label>
                        <input type="text" name="publisher" class="form-control" placeholder="Enter publisher" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price (USD)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="text" name="price" class="form-control" placeholder="0.00" required pattern="^\d+(\.\d{1,2})?$" title="Enter a valid price">
                        </div>
                    </div>
                </div>

                <div class="form-section-title mt-4">
                    <i class="fas fa-book-open mr-2 text-primary"></i> Technical Details
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Language</label>
                        <input type="text" name="language" class="form-control" placeholder="English, etc." required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Edition</label>
                        <input type="text" name="edition" class="form-control" placeholder="1st, 2nd, etc." required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Pages</label>
                        <input type="number" name="noOfPages" class="form-control" placeholder="300" required min="1">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Country of Origin</label>
                        <input type="text" name="country" class="form-control" placeholder="USA, UK, etc." required>
                    </div>
                </div>

                <div class="form-section-title mt-4">
                    <i class="fas fa-image mr-2 text-primary"></i> Media Upload
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Book Cover Image</label>
                        <input type="file" name="bookImage" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Author Image (Optional)</label>
                        <input type="file" name="authorImage" class="form-control">
                    </div>
                </div>

                <hr class="my-4">
                
                <div class="text-right">
                    <button type="reset" class="btn btn-light mr-2">Reset Form</button>
                    <button type="submit" class="submit-btn">Add Book to Library</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('./base/footer.ejs') %>