<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Library Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Nunito', sans-serif;
        }

        body, html {
            height: 100%;
            width: 100%;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Robot Background */
        .robot-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .robot-background iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Glassmorphism Login Card */
        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 420px;
            padding: 50px 40px;
            background: rgba(255, 255, 255, 0.15); /* Semi-transparent */
            backdrop-filter: blur(20px); /* Blur effect */
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 30px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            text-align: center;
            color: #fff;
        }

        .login-header i {
            font-size: 3.5rem;
            color: #fff;
            margin-bottom: 15px;
            text-shadow: 0 0 10px rgba(0,0,0,0.2);
        }

        .login-header h1 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 10px;
            color: #fff;
        }

        .login-header p {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            color: #fff;
            font-size: 0.9rem;
        }

        .form-control {
            width: 100%;
            padding: 14px 18px;
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.2);
            border-color: #fff;
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
            outline: none;
        }

        .login-btn {
            width: 100%;
            padding: 16px;
            background: #fff;
            color: #2c3e50;
            border: none;
            border-radius: 15px;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
            background: #f8f9fa;
        }

        .footer-links {
            margin-top: 30px;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .footer-links a {
            color: #fff;
            text-decoration: underline;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <!-- Robot Integrated Background -->
    <div class="robot-background">
        <iframe src='https://my.spline.design/robotinteractiveevents-5864473e1a2171a0a5458b8bd11d54bf/' frameborder='0'></iframe>
    </div>

    <!-- Integrated Login Form -->
    <div class="login-card">
        <div class="login-header">
            <i class="fas fa-book-reader"></i>
            <h1>Welcome Back</h1>
            <p>Access your library management portal</p>
        </div>

        <form action="/login/user" method="post">
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" name="username" class="form-control" placeholder="admin@example.com" required>
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" class="login-btn">Log In</button>
        </form>

        <div class="footer-links">
            <p>Don't have an account? <a href="/signup">Sign up here</a></p>
        </div>
    </div>
</body>
</html>
