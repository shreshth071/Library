<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Books Library</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #4e73df;
            --success: #1cc88a;
            --info: #36b9cc;
            --warning: #f6c23e;
            --danger: #e74a3b;
            --dark: #5a5c69;
            --sidebar-dark: #1a202c;
            --bg-light: #f8f9fa;
        }

        body {
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg-light);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .main-container {
            display: flex;
            min-height: 100vh;
        }

        /* Hide the default Bootstrap navbar if we are using the custom sidebar */
        .admin-navbar {
            display: none !important;
        }
    </style>
</head>
<body>
    <!-- Navbar (Hidden by default for admin pages, can be enabled if needed) -->
    <nav class="navbar navbar-expand-lg bg-info admin-navbar" style="position: fixed; width: 100%; top: 0; z-index: 1000;">
        <div class="container-fluid" style="background-color: #2c3e50;">
            <a class="navbar-brand" href="#" style="color: #ecf0f1;">Admin - Books Library</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/signup" style="color: #ecf0f1;">Add New User</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" style="color: #ecf0f1;">List</a>
                    </li>
                </ul>
                <form class="d-flex" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" style="margin: 8px; background-color: #f1f1f1; border-color: #7f8c8d;">
                    <button class="btn btn-outline-success" type="submit" style="margin: 8px; color: white; background-color: #27ae60; border-color: #27ae60;">Search</button>
                </form>
            </div>
        </div>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+qao8LBYSkQ/7OFylH4Q9Jp4DyhHU" crossorigin="anonymous"></script>
</body>
</html>
