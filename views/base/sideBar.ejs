<style>
    .sidebar {
        width: 250px;
        height: 100vh;
        background: #1a202c; /* Modern dark background */
        padding: 20px 0;
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0; /* Align to top */
        left: 0;
        overflow-y: auto;
        color: #e2e8f0;
        z-index: 1100;
        box-shadow: 4px 0 10px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }
    
    .sidebar-header {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid #2d3748;
        margin-bottom: 20px;
    }

    .sidebar-header h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: 1px;
    }
    
    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .menu-item {
        padding: 4px 16px;
    }
    
    .menu-item a {
        text-decoration: none;
        color: #a0aec0;
        font-size: 1rem;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    
    .menu-item a i {
        width: 24px;
        margin-right: 12px;
        font-size: 1.1rem;
        text-align: center;
    }
    
    .menu-item a:hover, .menu-item.active a {
        background-color: #2d3748;
        color: #fff;
    }

    .menu-item a:hover i, .menu-item.active a i {
        color: #63b3ed; /* Light blue accent */
    }
    
    .submenu {
        list-style: none;
        padding: 8px 0 8px 40px;
        display: none;
    }
    
    .menu-item.show .submenu {
        display: block;
    }
    
    .submenu li a {
        padding: 8px 12px;
        font-size: 0.9rem;
        color: #718096;
    }

    .submenu li a:hover {
        color: #fff;
        background: transparent;
    }

    /* Chevron rotation */
    .fa-chevron-down {
        transition: transform 0.3s ease;
    }
    .menu-item.show .fa-chevron-down {
        transform: rotate(180deg);
    }
</style>

<!-- Sidebar Container -->
<div class="sidebar">
    <div class="sidebar-header">
        <h2>LIBRARY ADMIN</h2>
    </div>
    <ul class="sidebar-menu">
        <li class="menu-item">
            <a href="/dashboard">
                <i class="fas fa-th-large"></i>
                Dashboard
            </a>
        </li>
        <li class="menu-item">
            <a href="/users">
                <i class="fas fa-users"></i>
                Users List
            </a>
        </li>
        <li class="menu-item" id="books-menu">
            <a href="javascript:void(0)">
                <i class="fas fa-book"></i>
                Books
                <i class="fas fa-chevron-down" style="margin-left:auto; font-size: 0.8rem;"></i>
            </a>
            <ul class="submenu">
                <li>
                    <a href="/book/add/page">
                        <i class="fas fa-plus-circle"></i>
                        Add New
                    </a>
                </li>
                <li>
                    <a href="/books/list">
                        <i class="fas fa-list-ul"></i>
                        Book List
                    </a>
                </li>
            </ul>
        </li>
        <li class="menu-item">
            <a href="/settings">
                <i class="fas fa-sliders-h"></i>
                Settings
            </a>
        </li>
        <li class="menu-item" style="margin-top: auto; padding-top: 20px; border-top: 1px solid #2d3748;">
            <a href="/login" style="color: #fc8181;">
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </a>
        </li>
    </ul>
</div>

<script>
    document.getElementById('books-menu').addEventListener('click', function(e) {
        // Prevent closing when clicking sublinks
        if (e.target.closest('.submenu')) return;
        this.classList.toggle('show');
    });

    // Mark active link
    const currentPath = window.location.pathname;
    document.querySelectorAll('.menu-item a').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
            link.parentElement.classList.add('active');
            if (link.closest('.submenu')) {
                link.closest('.menu-item').classList.add('show');
            }
        }
    });
</script>
